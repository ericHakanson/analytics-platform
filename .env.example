# Environment mode
PUBLISHING_DATA_MODE=sample
VITE_PUBLISHING_ENV=local

# Contract export root used by source queries
EVIDENCE_VAR__contract_root=./data/contracts/csv

# Google Cloud PostgreSQL credentials (live data mode)
# Store actual values in sources/google_cloud_postgresql/connection.options.yaml (gitignored)
# connection.options.yaml format:
#   host: <cloud-sql-public-ip>
#   port: 5432
#   database: <database-name>
#   user: <username>
#   password: <password>
#   ssl: true

# Public and CTA URLs used by pages
VITE_PUBLIC_SITE_BASE_URL=http://localhost:3000
VITE_HUBSPOT_FORM_BASE_URL=https://go.fortisland.example/request-briefing
VITE_HUBSPOT_CAMPAIGN_UTM_SOURCE=fortisland-signals
