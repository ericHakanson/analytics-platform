{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortisland.local/contracts/publishing/market_sale_activity.v1.schema.json",
  "title": "market_sale_activity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "owner",
    "refresh_cadence",
    "source_layers",
    "grain",
    "date_range",
    "market",
    "records"
  ],
  "properties": {
    "contract_name": {
      "const": "market_sale_activity"
    },
    "contract_version": {
      "const": "v1"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "refresh_cadence": {
      "const": "weekly"
    },
    "grain": {
      "const": "market_time_window"
    },
    "source_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "canonical_property_layer",
          "event_layer",
          "derived_commercial_layer"
        ]
      }
    },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "end_date"
      ],
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "market_slug",
          "period_start",
          "period_end",
          "sale_events_30d",
          "new_sale_events",
          "late_sale_events",
          "new_listing_events",
          "active_for_sale_count",
          "median_sale_price_30d",
          "data_as_of",
          "last_updated_at"
        ],
        "properties": {
          "market_slug": {
            "type": "string"
          },
          "period_start": {
            "type": "string",
            "format": "date"
          },
          "period_end": {
            "type": "string",
            "format": "date"
          },
          "sale_events_30d": {
            "type": "integer",
            "minimum": 0
          },
          "new_sale_events": {
            "type": "integer",
            "minimum": 0
          },
          "late_sale_events": {
            "type": "integer",
            "minimum": 0
          },
          "new_listing_events": {
            "type": "integer",
            "minimum": 0
          },
          "active_for_sale_count": {
            "type": "integer",
            "minimum": 0
          },
          "median_sale_price_30d": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "data_as_of": {
            "type": "string",
            "format": "date"
          },
          "last_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
