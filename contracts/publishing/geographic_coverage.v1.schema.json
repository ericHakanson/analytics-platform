{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortisland.local/contracts/publishing/geographic_coverage.v1.schema.json",
  "title": "geographic_coverage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "owner",
    "refresh_cadence",
    "source_layers",
    "grain",
    "date_range",
    "market",
    "records"
  ],
  "properties": {
    "contract_name": {
      "const": "geographic_coverage"
    },
    "contract_version": {
      "const": "v1"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "refresh_cadence": {
      "const": "weekly"
    },
    "grain": {
      "const": "market_time_window"
    },
    "source_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "canonical_property_layer",
          "event_layer",
          "derived_commercial_layer"
        ]
      }
    },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "end_date"
      ],
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "market_slug",
          "period_start",
          "period_end",
          "zip_count_in_region",
          "zip_count_with_properties",
          "data_as_of",
          "last_updated_at"
        ],
        "properties": {
          "market_slug": {
            "type": "string"
          },
          "period_start": {
            "type": "string",
            "format": "date"
          },
          "period_end": {
            "type": "string",
            "format": "date"
          },
          "zip_count_in_region": {
            "type": "integer",
            "minimum": 0
          },
          "zip_count_with_properties": {
            "type": "integer",
            "minimum": 0
          },
          "data_as_of": {
            "type": "string",
            "format": "date"
          },
          "last_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
