{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortisland.local/contracts/publishing/asset-metadata.schema.json",
  "title": "Fort Island publishing asset metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "route_path",
    "asset_type",
    "audience",
    "market",
    "date_range",
    "refresh_cadence",
    "primary_message",
    "why_it_matters",
    "supporting_metrics",
    "cta",
    "channel_suitability",
    "status",
    "owner",
    "freshness",
    "contract"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^(proof|campaigns|briefings)\\/[a-z0-9-]+\\/[a-z0-9-]+$"
    },
    "route_path": {
      "type": "string",
      "pattern": "^\\/(proof|campaigns|briefings)\\/[a-z0-9-]+\\/[a-z0-9-]+$"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "evergreen_proof",
        "campaign",
        "client_briefing"
      ]
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "public_website_visitor",
          "prospect",
          "active_client",
          "operator",
          "social_audience"
        ]
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "geography_scope",
        "state_code"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "geography_scope": {
          "type": "string",
          "enum": [
            "county",
            "multi_county",
            "state",
            "town",
            "region",
            "campaign_segment"
          ]
        },
        "state_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "start_date",
        "end_date"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "refresh_cadence": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "campaign_bound",
        "ad_hoc"
      ]
    },
    "primary_message": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1
    },
    "supporting_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_key",
          "label"
        ],
        "properties": {
          "metric_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target_type",
        "target_url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "type": "string",
          "enum": [
            "hubspot_form",
            "hubspot_landing_page",
            "squarespace_page",
            "email_link",
            "internal_placeholder"
          ]
        },
        "target_url": {
          "type": "string",
          "minLength": 1
        },
        "utm_medium": {
          "type": "string",
          "minLength": 1
        },
        "utm_campaign": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "channel_suitability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "website",
        "outbound",
        "social",
        "briefing"
      ],
      "properties": {
        "website": {
          "type": "boolean"
        },
        "outbound": {
          "type": "boolean"
        },
        "social": {
          "type": "boolean"
        },
        "briefing": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "deprecated"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "operator",
            "marketing",
            "client_success",
            "sales"
          ]
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_updated_at",
        "data_as_of",
        "refresh_notes",
        "source_systems"
      ],
      "properties": {
        "last_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "data_as_of": {
          "type": "string",
          "format": "date"
        },
        "refresh_notes": {
          "type": "string",
          "minLength": 1
        },
        "source_systems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "zillow",
              "redfin",
              "internal_curated"
            ]
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        }
      }
    }
  }
}
